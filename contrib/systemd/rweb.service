# rweb as a systemd user service (docs/user-guide.md, "Run behind Tailscale on Linux"). For an archive
# installed in ~/.local/bin, copy this to ~/.config/systemd/user/rweb.service; packages install it in
# /usr/lib/systemd/user with their own path to rweb. For an SSH tunnel, make the command `rweb ssh`.
[Unit]
Description=rweb, a web client for Rex
# If your Rex server runs as a user service, start after it:
After=rex.service
Wants=rex.service

[Service]
ExecStart=%h/.local/bin/rweb tailscale
# rweb waits for Tailscale and Rex by itself; this restarts it only if it stops.
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
